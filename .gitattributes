# Normalise all text files to LF on checkout
* text=auto eol=lf

# Explicitly binary — never diff or merge
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.db   binary
*.sqlite binary
*.pyc  binary

*.sqlite3 binary
*.so binary
*.pyd binary

# Dev-only: excluded from git archive (GitHub "Download ZIP" and release tarballs).
# These are development scaffolding -- they should never appear in a user download.
# To add a new dev-only path, append it here. Everything NOT listed ships to users.
.claude/              export-ignore
src/                  export-ignore
responses/            export-ignore
tasks/                export-ignore
.env.example          export-ignore
AGENTS.md             export-ignore
CLAUDE.md             export-ignore
RELEASING.md          export-ignore
prepare-release.py    export-ignore
release.sh            export-ignore
.githooks/            export-ignore
docs/AdvantagesOfGoalVsPlainClaude.md export-ignore
docs/architecture.md  export-ignore
docs/customizing.md   export-ignore
docs/doc-index.md     export-ignore
docs/goal.md          export-ignore
